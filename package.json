{
  "name": "iploom-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "IPloom Studio — a local-first, bilingual IP bible and novel workspace with ArcReel-ready 3D comic-drama handoffs.",
  "author": "j4tmr",
  "license": "MIT",
  "homepage": "https://github.com/j4tmr/iploom",
  "repository": {
    "type": "git",
    "url": "https://github.com/j4tmr/iploom.git"
  },
  "bugs": {
    "url": "https://github.com/j4tmr/iploom/issues"
  },
  "keywords": [
    "ip",
    "worldbuilding",
    "novel",
    "screenwriting",
    "storyboard",
    "arcreel",
    "electron",
    "local-first"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run studio:dev",
    "build": "bun run studio:build:release",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test:coverage && bun run studio:build:release && bun scripts/studio/verify-release-inputs.ts inputs && bun scripts/studio/verify-release-inputs.ts docs && bun run studio:verify-mcp",
    "test": "bun test tests/studio",
    "test:studio": "bun test tests/studio",
    "test:coverage": "bun test tests/studio --coverage",
    "typecheck": "tsc -p apps/studio/tsconfig.json --noEmit",
    "typecheck:studio": "tsc -p apps/studio/tsconfig.json --noEmit",
    "studio:dev": "bun scripts/studio/dev.ts",
    "studio:build": "bun scripts/studio/build.ts",
    "studio:build:release": "bun scripts/studio/build.ts --mcp-binary",
    "studio:dir": "bun run studio:build:release && bun scripts/studio/package.ts --dir",
    "studio:package": "bun run studio:build:release && bun scripts/studio/package.ts",
    "studio:smoke": "bun scripts/studio/smoke.ts",
    "studio:smoke:package": "bun scripts/studio/smoke.ts --packaged",
    "studio:mcp": "bun apps/studio/mcp/server.ts",
    "studio:verify-mcp": "bun scripts/studio/verify-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@happy-dom/global-registrator": "21.0.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
